** EPITECH PROJECT, 2026
** GameQuizTests.cpp
** File description:
** unit tests of GameQuiz, the quiz parser and the trivia loop
*/

#include <criterion/criterion.h>
#include <criterion/redirect.h>
#include <string>

#include "Exceptions/ParserException.hpp"
#include "Server/Quiz/GameQuiz.hpp"

Test(quiz_parser, valid_quiz) {
    cr_assert_no_throw(GameQuiz("tests/Configs/valid_one_question.epikahoot"),
        ParserException);
}

Test(quiz_parser, no_title) {
    cr_assert_no_throw(GameQuiz("tests/Configs/no_title.epikahoot"),
        ParserException);
}

Test(quiz_parser, no_question) {
    cr_assert_throw(GameQuiz("tests/Configs/no_question.epikahoot"),
        ParserException);
}

Test(quiz_parser, no_question_message) {
    std::string message;

    try {
        const GameQuiz quiz("tests/Configs/no_question.epikahoot");
    } catch (const ParserException &e) {
        message = e.what();
    }
    cr_assert_str_eq(message.c_str(),
        "Quizzes must be at least 1 question long!");
}

Test(quiz_parser, empty_question_table) {
    cr_assert_throw(GameQuiz("tests/Configs/empty_question_table.epikahoot"),
        ParserException);
}

Test(quiz_parser, empty_question_text) {
    cr_assert_throw(GameQuiz("tests/Configs/empty_question_text.epikahoot"),
        ParserException);
}

Test(quiz_parser, non_printable_question) {
    cr_assert_throw(
        GameQuiz("tests/Configs/non_printable_question.epikahoot"),
        ParserException);
}

Test(quiz_parser, string_delay) {
    cr_assert_throw(GameQuiz("tests/Configs/string_delay.epikahoot"),
        ParserException);
}

Test(quiz_parser, list_delay) {
    cr_assert_throw(GameQuiz("tests/Configs/list_delay.epikahoot"),
        ParserException);
}

Test(quiz_parser, negative_delay) {
    cr_assert_throw(GameQuiz("tests/Configs/negative_delay.epikahoot"),
        ParserException);
}

Test(quiz_parser, zero_delay) {
    cr_assert_throw(GameQuiz("tests/Configs/zero_delay.epikahoot"),
        ParserException);
}

Test(quiz_parser, float_delay) {
    cr_assert_throw(GameQuiz("tests/Configs/float_delay.epikahoot"),
        ParserException);
}

Test(quiz_parser, too_long_delay) {
    cr_assert_throw(GameQuiz("tests/Configs/too_long_delay.epikahoot"),
        ParserException);
}

Test(quiz_parser, zero_answer) {
    cr_assert_throw(GameQuiz("tests/Configs/zero_answer.epikahoot"),
        ParserException);
}

Test(quiz_parser, one_answer) {
    cr_assert_throw(GameQuiz("tests/Configs/one_answer.epikahoot"),
        ParserException);
}

Test(quiz_parser, non_printable_answer) {
    cr_assert_throw(GameQuiz("tests/Configs/non_printable_answer.epikahoot"),
        ParserException);
}

Test(quiz_parser, five_answers) {
    cr_assert_throw(GameQuiz("tests/Configs/five_answers.epikahoot"),
        ParserException);
}

Test(quiz_parser, lowercase_solution) {
    cr_assert_throw(GameQuiz("tests/Configs/lowercase_solution.epikahoot"),
        ParserException);
}

Test(quiz_parser, out_of_range_solution) {
    cr_assert_throw(
        GameQuiz("tests/Configs/out_of_range_solution.epikahoot"),
        ParserException);
}

Test(quiz_parser, non_printable_solution) {
    cr_assert_throw(
        GameQuiz("tests/Configs/non_printable_solution.epikahoot"),
        ParserException);
}

Test(quiz_parser, trailing_solution) {
    cr_assert_throw(GameQuiz("tests/Configs/trailing_solution.epikahoot"),
        ParserException);
}

Test(trivia_loop, quiz_not_over_before_first_question) {
    const GameQuiz quiz("tests/Configs/valid_one_question.epikahoot");

    cr_assert_not(quiz.quizIsOver());
}

Test(trivia_loop, quiz_over_after_last_question, .init = cr_redirect_stdout) {
    GameQuiz quiz("tests/Configs/valid_one_question.epikahoot");

    quiz.nextQuestion();
    cr_assert(quiz.quizIsOver());
}
